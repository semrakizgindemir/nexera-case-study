# =====================================================================
# Choose ANY provider. You do NOT need to pay for anything.
# Uncomment and fill in the one you decide to use, then rename
# this file to ".env.local".
#
# Option A - Local model (fully free, no signup): Ollama
#   Install Ollama, run a model (e.g. "ollama run llama3.1"),
#   and point to it:
# OLLAMA_BASE_URL=http://localhost:11434
#
# Option B - Free API tiers (no hardware needed):
# GEMINI_API_KEY=
# GROQ_API_KEY=
#
# Option C - Any other provider you prefer:
# OPENAI_API_KEY=
